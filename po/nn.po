#: gdk/win32/gdkclipdrop-win32.c:684
#, c-format
msgid "Cannot claim clipboard ownership. OpenClipboard() timed out."
msgstr "Kan ikkje hevda eigarskap av utklippstavla. OpenClipboard() tima ut."

#: gdk/win32/gdkclipdrop-win32.c:694
#, c-format
msgid "Cannot claim clipboard ownership. Another process claimed it before us."
msgstr ""
"Kan ikkje krevja eigarskap av utklippstavla. Ein annan prosess kravde det "
"før oss."

#: gdk/win32/gdkclipdrop-win32.c:708
#, c-format
msgid "Cannot claim clipboard ownership. OpenClipboard() failed: 0x%lx."
msgstr ""
"Kan ikkje hevda eigarskap til utklippstavla. OpenClipboard() feila: 0x%lx."

#: gdk/win32/gdkclipdrop-win32.c:718
#, c-format
msgid "Cannot claim clipboard ownership. EmptyClipboard() failed: 0x%lx."
msgstr ""
"Kan ikkje krevja eigarskap til utklippstavla. EmptyClipboard() mislukkast: "
"0x%lx."

#: gdk/win32/gdkclipdrop-win32.c:760
#, c-format
msgid "Cannot set clipboard data. OpenClipboard() timed out."
msgstr "Kan ikkje setje utklippstavle-data. OpenClipboard() tima ut."

#: gdk/win32/gdkclipdrop-win32.c:770 gdk/win32/gdkclipdrop-win32.c:801
#, c-format
msgid "Cannot set clipboard data. Another process claimed clipboard ownership."
msgstr ""
"Kan ikkje setje utklippstavle-data. Ein annan prosess har kravd eigarskap på "
"utklippstavla."

#: gdk/win32/gdkclipdrop-win32.c:784
#, c-format
msgid "Cannot set clipboard data. OpenClipboard() failed: 0x%lx."
msgstr "Kan ikkje setje utklippstavledata. OpenClipboard() feila: 0x%lx."

#: gdk/win32/gdkclipdrop-win32.c:836
#, c-format
msgid "Cannot get clipboard data. GlobalLock(0x%p) failed: 0x%lx."
msgstr "Klarar ikkje henta ut klippebrettdata. GlobalLock(0x%p) feila: 0x%lx."

#: gdk/win32/gdkclipdrop-win32.c:847
#, c-format
msgid "Cannot get clipboard data. GlobalSize(0x%p) failed: 0x%lx."
msgstr ""
"Får ikkje henta ut klippehandsamingsdata. GlobalSize(0x%p) feila: 0x%lx."

#: gdk/win32/gdkclipdrop-win32.c:860
#, c-format
msgid ""
"Cannot get clipboard data. Failed to allocate %s bytes to store the data."
msgstr ""
"Kan ikkje hente ut klippebrettdata. Mislukka med å allokere %s byte for å "
"lagra data."

#: gdk/win32/gdkclipdrop-win32.c:892
#, c-format
msgid "Cannot get clipboard data. OpenClipboard() timed out."
msgstr "Kan ikkje henta ut klippebrettdata. OpenClipboard() tok for lang tid."

#: gdk/win32/gdkclipdrop-win32.c:902
#, c-format
msgid "Cannot get clipboard data. Clipboard ownership changed."
msgstr "Kan ikkje henta utklippdata. Eigarskap til utklipp endra."

#: gdk/win32/gdkclipdrop-win32.c:912
#, c-format
msgid ""
"Cannot get clipboard data. Clipboard data changed before we could get it."
msgstr "Kan ikkje henta utklippdata. Utklippdata endra før vi klarte å henta dei."

#: gdk/win32/gdkclipdrop-win32.c:930
#, c-format
msgid "Cannot get clipboard data. OpenClipboard() failed: 0x%lx."
msgstr "Klarar ikkje henta ut klippebrettdata. OpenClipboard() feila: 0x%lx."

#: gdk/win32/gdkclipdrop-win32.c:956
#, c-format
msgid "Cannot get clipboard data. No compatible transfer format found."
msgstr "Kan ikkje henta utklippdata. Ingenting overføringsformat funne."

#: gdk/win32/gdkclipdrop-win32.c:966
#, c-format
msgid "Cannot get clipboard data. GetClipboardData() failed: 0x%lx."
msgstr "Kan ikkje hente utklippdata. GetClipboardData() feila: 0x%lx."

#: gdk/win32/gdkdrop-win32.c:948
#, c-format
msgid "Cannot get DnD data. GlobalLock(0x%p) failed: 0x%lx."
msgstr "Får ikkje DnD-data. GlobalLock(0x%p) feila: 0x%lx."

#: gdk/win32/gdkdrop-win32.c:957
#, c-format
msgid "Cannot get DnD data. GlobalSize(0x%p) failed: 0x%lx."
msgstr "Kan ikkje henta DnD-data. GlobalSize(0x%p) feila: 0x%lx."

#: gdk/win32/gdkdrop-win32.c:968
#, c-format
msgid "Cannot get DnD data. Failed to allocate %s bytes to store the data."
msgstr ""
"Klarar ikkje å henta DnD-data. Klarte ikkje å reservere %s byte for å lagra "
"data."

#: gdk/win32/gdkdrop-win32.c:1038
