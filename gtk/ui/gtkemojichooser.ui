<?xml version="1.0" encoding="UTF-8"?>
<interface domain="gtk40">
  <template class="GtkEmojiChooser" parent="GtkPopover">
    <style>
      <class name="emoji-picker" />
    </style>
    <property name="child">
      <object class="GtkBox" id="box">
        <property name="orientation">1</property>
        <child>
          <object class="GtkBox">
            <style>
              <class name="emoji-searchbar" />
            </style>
            <child>
              <object class="GtkSearchEntry" id="search_entry">
                <property name="hexpand">1</property>
                <signal name="search-changed" handler="search_changed" />
                <signal name="stop-search" handler="stop_search" />
                <signal name="activate" handler="activate_search" object="GtkEmojiChooser" swapped="yes" />
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkStack" id="stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">grid</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="grid_scroller">
                    <property name="vexpand">1</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="height-request">320</property>
                    <property name="vadjustment">
                      <object class="GtkAdjustment">
                        <signal name="value-changed" handler="grid_viewport_changed" />
                        <signal name="changed" handler="grid_viewport_changed" />
                      </object>
                    </property>
                    <style>
                      <class name="view" />
                    </style>
                    <property name="child">
                      <object class="GtkGridView" id="grid_view">
                        <property name="max-columns">7</property>
                        <property name="single-click-activate">1</property>
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <property name="header-factory">header_factory</property>
                        <property name="factory">
                          <object class="GtkSignalListItemFactory">
                            <signal name="setup" handler="grid_setup" />
                            <signal name="bind" handler="grid_bind" />
                            <signal name="unbind" handler="grid_unbind" />
                          </object>
                        </property>
                        <signal name="activate" handler="grid_activated" />
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">empty</property>
                <property name="child">
                  <object class="GtkGrid">
                    <property name="margin-top">18</property>
                    <property name="margin-bottom">18</property>
                    <property name="row-spacing">12</property>
                    <property name="halign">3</property>
                    <property name="valign">3</property>
                    <style>
                      <class name="dim-label" />
                    </style>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">edit-find-symbolic</property>
                        <property name="pixel-size">72</property>
                        <style>
                          <class name="dim-label" />
                        </style>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">No Results Found</property>
                        <property name="attributes">0 -1 weight bold, 0 -1 scale 1.44</property>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">1</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Try a different search</property>
                        <style>
                          <class name="dim-label" />
                        </style>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">2</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkFlowBox">
            <property name="min-children-per-line">3</property>
            <property name="max-children-per-line">10</property>
            <property name="selection-mode">0</property>
            <style>
              <class name="emoji-toolbar" />
            </style>
            <child>
              <object class="GtkButton" id="sections[0].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-recent-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Recent</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[1].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-people-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Smileys &amp; People</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[2].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-body-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Body &amp; Clothing</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[3].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-nature-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Animals &amp; Nature</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[4].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-food-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Food &amp; Drink</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[5].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-travel-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Travel &amp; Places</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[6].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-activities-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Activities</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[7].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-objects-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Objects</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[8].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-symbols-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Symbols</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="sections[9].button">
                <signal name="clicked" handler="section_clicked" />
                <property name="icon-name">emoji-flags-symbolic</property>
                <property name="has-frame">0</property>
                <property name="tooltip-text" translatable="yes" context="emoji category">Flags</property>
                <style>
                  <class name="emoji-section" />
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
  <object class="GtkSignalListItemFactory" id="header_factory">
    <signal name="setup" handler="header_setup" />
    <signal name="bind" handler="header_bind" />
  </object>
  <object class="GtkSignalListItemFactory" id="variation_factory">
    <signal name="setup" handler="variation_setup" />
    <signal name="bind" handler="grid_bind" />
    <signal name="unbind" handler="grid_unbind" />
  </object>
</interface>
