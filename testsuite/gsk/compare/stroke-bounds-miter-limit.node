color {
  color: black;
  bounds: -20 -20 200 160;
}

stroke {
  path: "p" {
    "M 10 10 h 20 v 10 h -20 v 10 h 20 v -5 h -11 l 2 -10";
  }
  line-width: 10;
  line-cap: square;
  miter-limit: 2;
}

transform {
  transform: translate(40,0);
  child: stroke {
    path: "p";
    line-width: 10;
    line-cap: square;
    miter-limit: 2.5;
  }
}

