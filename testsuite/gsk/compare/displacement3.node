color {
  bounds: 0 0 100 100;
  color: pink;
}

displacement {
  clip: 25 25 100 100;
  channels: red green;
  scale: 20 20;
  max: 20 20;
  displacement: container {
    color {
      bounds: 0 0 200 200;
      color: color(srgb 1 1 0);
    }
    color {
      bounds: 0 0 50 50;
      color: color(srgb 1 1 0);
    }
    color {
      bounds: 50 0 50 50;
      color: color(srgb 0 1 0);
    }
    color {
      bounds: 0 50 50 50;
      color: color(srgb 1 0 0);
    }
    color {
      bounds: 50 50 50 50;
      color: color(srgb 0 0 0);
    }
  }
  child: container {
    color {
      bounds: 0 0 50 50;
      color: rgb(0,0,0);
    }
    color {
      bounds: 50 0 50 50;
      color: rgb(0,255,0);
    }
    color {
      bounds: 0 50 50 50;
      color: rgb(255,0,0);
    }
    color {
      bounds: 50 50 50 50;
      color: rgb(255,255,0);
    }
  }
}
