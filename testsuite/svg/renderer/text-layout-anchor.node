clip {
  clip: 0 0 200 200;
  child: container {
    stroke {
      child: color {
        bounds: 99.5 -0.5 1 151;
        color: rgb(173,216,230);
      }
      path: "M 100 0 L 100 150";
      line-width: 1;
      line-cap: butt;
      line-join: miter;
    }
    stroke {
      child: color {
        bounds: 0.5 0.5 199 199;
        color: rgb(0,0,0);
      }
      path: 1 1 198 198;
      line-width: 1;
      line-cap: butt;
      line-join: miter;
    }
  }
}
