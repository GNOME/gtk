clip {
  clip: 0 0 120 40;
  child: transform {
    transform: scale(0.1);
    child: container {
      stroke {
        child: color {
          bounds: 0 0 1200 400;
          color: rgb(0,0,255);
        }
        path: 1 1 1198 398;
        line-width: 2;
        line-cap: butt;
        line-join: miter;
      }
      transform {
        transform: translate(300, 200);
        child: fill {
          child: color {
            bounds: -250 -100 500 200;
            color: rgb(255,0,0);
          }
          path: "M 250 0 O 250 100, 0 100, 0.70710676908493042\
                 O -250 100, -250 0, 0.70710676908493042\
                 O -250 -100, 0 -100, 0.70710676908493042\
                 O 250 -100, 250 0, 0.70710676908493042 Z";
          fill-rule: winding;
        }
      }
      transform {
        transform: translate(900, 200) rotate(330);
        child: stroke {
          child: color {
            bounds: -290 -140 580 280;
            color: rgb(0,0,255);
          }
          path: "M 250 0 O 250 100, 0 100, 0.70710676908493042\
                 O -250 100, -250 0, 0.70710676908493042\
                 O -250 -100, 0 -100, 0.70710676908493042\
                 O 250 -100, 250 0, 0.70710676908493042 Z";
          line-width: 20;
          line-cap: butt;
          line-join: miter;
        }
      }
    }
  }
}
