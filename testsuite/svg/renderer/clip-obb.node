mask {
  source: color {
    bounds: 10 10 80 80;
    color: rgb(255,0,0);
  }
  mask: rounded-clip {
    clip: 10 10 80 80 / 40;
    child: color {
      bounds: 10 10 80 80;
      color: rgb(0,0,0);
    }
  }
}
mask {
  source: color {
    bounds: 120 10 100 80;
    color: rgb(0,128,0);
  }
  mask: container {
    color {
      bounds: 120 10 40 80;
      color: rgb(0,0,0);
    }
    color {
      bounds: 170 10 40 80;
      color: rgb(0,0,0);
    }
  }
}
mask {
  source: color {
    bounds: 10 110 80 80;
    color: rgb(0,0,255);
  }
  mask: transform {
    transform: rotate(15);
    child: color {
      bounds: 10 110 80 80;
      color: rgb(0,0,0);
    }
  }
}
