rounded-clip {
  clip: 20 40 160 120 / 80 / 60;
  child: repeat {
    bounds: 20 40 160 120;
    child-bounds: 0 0 25 25;
    child: container {
      rounded-clip {
        clip: 2.5 2.5 20 20 / 10;
        child: color {
          bounds: 2.5 2.5 20 20;
          color: rgb(255,0,0);
        }
      }
      stroke {
        child: color {
          bounds: 2 2 21 21;
          color: rgb(0,0,0);
        }
        path: circle {
          center: 12.5 12.5;
          radius: 10;
        }
        line-width: 1;
        line-cap: butt;
        line-join: miter;
      }
    }
  }
}
